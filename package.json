{
  "name": "bulletin",
  "version": "0.1.45",
  "private": true,
  "description": "A desktop bullet-journal app",
  "desktopName": "bulletin.desktop",
  "repository": "iErik/bulletin",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Erik Isidore",
    "email": "ericssonico@protonmail.ch",
    "url": "https://github.com/ierik"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "postinstall": "node -e \"process.env.ELECTRON_SKIP_BINARY_DOWNLOAD || require('electron')\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "vue-tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "lint": "pnpm lint:es && pnpm lint:style",
    "lint:es": "eslint --max-warnings 0 .",
    "lint:style": "stylelint --max-warnings 0 \"**/*.{scss,vue}\"",
    "lint:fix": "eslint --fix .; e=$?; stylelint --fix \"**/*.{scss,vue}\" || e=1; exit $e",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "electron-log": "^5.4.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/ubuntu-sans": "5.3.0",
    "@lucide/vue": "^1.62.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "1.0.0-rc.5",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "pinia": "^4.1.0",
    "postcss-html": "^2.0.0",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.14"
  }
}

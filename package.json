{
  "name": "bulletin",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop bullet-journal app",
  "repository": "iErik/bulletin",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Erik Isidore",
    "email": "ericssonico@protonmail.ch",
    "url": "https://github.com/ierik"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "postinstall": "node -e \"process.env.ELECTRON_SKIP_BINARY_DOWNLOAD || require('electron')\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "vue-tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "1.0.0-rc.5",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
